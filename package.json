{
  "name": "farsi-mock",
  "version": "2.0.1",
  "description": "Realistic, algorithmically valid Iranian test data (Faker for Iran): کد ملی, Sheba, cards, mobiles, addresses, toman prices, Jalali dates. Schema inference from Prisma/Zod/Mongoose/OpenAPI, SQL/Mongo/TS output, seed helpers, mock API and MCP server.",
  "keywords": [
    "faker",
    "mock",
    "fake-data",
    "test-data",
    "seed",
    "iran",
    "persian",
    "farsi",
    "jalali",
    "national-id",
    "code-melli",
    "sheba",
    "iban",
    "fixtures",
    "prisma",
    "zod",
    "mongoose",
    "openapi",
    "sql",
    "mock-server",
    "mcp",
    "seed-data",
    "frontend",
    "frontend-mock",
    "msw",
    "axios",
    "nextjs",
    "vite",
    "api-mock"
  ],
  "author": "Amir Hossein (https://github.com/amirjld)",
  "license": "MIT",
  "homepage": "https://github.com/amirjld/farsi-mock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirjld/farsi-mock.git"
  },
  "bugs": {
    "url": "https://github.com/amirjld/farsi-mock/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./infer": {
      "import": {
        "types": "./dist/infer.d.ts",
        "default": "./dist/infer.js"
      },
      "require": {
        "types": "./dist/infer.d.cts",
        "default": "./dist/infer.cjs"
      }
    },
    "./output": {
      "import": {
        "types": "./dist/output.d.ts",
        "default": "./dist/output.js"
      },
      "require": {
        "types": "./dist/output.d.cts",
        "default": "./dist/output.cjs"
      }
    },
    "./seed": {
      "import": {
        "types": "./dist/seed.d.ts",
        "default": "./dist/seed.js"
      },
      "require": {
        "types": "./dist/seed.d.cts",
        "default": "./dist/seed.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      },
      "require": {
        "types": "./dist/validate.d.cts",
        "default": "./dist/validate.cjs"
      }
    },
    "./jalali": {
      "import": {
        "types": "./dist/jalali.d.ts",
        "default": "./dist/jalali.js"
      },
      "require": {
        "types": "./dist/jalali.d.cts",
        "default": "./dist/jalali.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./frontend": {
      "import": {
        "types": "./dist/frontend.d.ts",
        "default": "./dist/frontend.js"
      },
      "require": {
        "types": "./dist/frontend.d.cts",
        "default": "./dist/frontend.cjs"
      }
    },
    "./frontend/runtime": {
      "import": {
        "types": "./dist/frontend-runtime.d.ts",
        "default": "./dist/frontend-runtime.js"
      },
      "require": {
        "types": "./dist/frontend-runtime.d.cts",
        "default": "./dist/frontend-runtime.cjs"
      }
    },
    "./frontend/client": {
      "import": {
        "types": "./dist/frontend-client.d.ts",
        "default": "./dist/frontend-client.js"
      },
      "require": {
        "types": "./dist/frontend-client.d.cts",
        "default": "./dist/frontend-client.cjs"
      }
    },
    "./browser": "./dist/farsi-mock.global.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "farsi-mock": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fa.md",
    "DATA_SOURCES.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "llms.txt",
    "skills"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.2.7",
    "jalaali-js": "^2.0.1",
    "sql.js": "^1.15.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "unpkg": "./dist/farsi-mock.global.js",
  "jsdelivr": "./dist/farsi-mock.global.js",
  "typesVersions": {
    "*": {
      "infer": [
        "./dist/infer.d.ts"
      ],
      "output": [
        "./dist/output.d.ts"
      ],
      "seed": [
        "./dist/seed.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "validate": [
        "./dist/validate.d.ts"
      ],
      "jalali": [
        "./dist/jalali.d.ts"
      ],
      "ai": [
        "./dist/ai.d.ts"
      ],
      "frontend": [
        "./dist/frontend.d.ts"
      ],
      "frontend/runtime": [
        "./dist/frontend-runtime.d.ts"
      ],
      "frontend/client": [
        "./dist/frontend-client.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "zod": ">=3.22",
    "msw": ">=2"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  }
}
